# ReserveChain — PRODUCTION environment (.env for ~/reservechain/production on the server).
# deploy.sh generates this file with random secrets on the first deploy of the environment. To pre-fill it
# instead, copy this file to deploy/env/production.env (git-ignored, never commit) and edit; deploy.sh uploads it
# only if the server has no .env yet (or with --push-env). Quote values containing $ with SINGLE quotes.

RC_ENV=production
SITE_HOST=reservechain.example.com
ADMIN_USER=rcadmin
ADMIN_EMAIL=ops@example.com
ADMIN_PASSWORD=generated-by-deploy
RC_FORCE_SSL_ADMIN=true

# --- secrets (generated by deploy.sh; unique per environment) ---
DB_PASSWORD=generated-by-deploy
DB_ROOT_PASSWORD=generated-by-deploy
RC_TOKEN_SECRET=generated-64-chars
RC_DEMO_PASSWORD=
# Token for GET /wp-json/rc/v1/health/full (header X-RC-Health-Token). >= 16 chars; empty disables the endpoint.
RC_HEALTH_TOKEN=generated-by-deploy
WORDPRESS_AUTH_KEY=generated
WORDPRESS_SECURE_AUTH_KEY=generated
WORDPRESS_LOGGED_IN_KEY=generated
WORDPRESS_NONCE_KEY=generated
WORDPRESS_AUTH_SALT=generated
WORDPRESS_SECURE_AUTH_SALT=generated
WORDPRESS_LOGGED_IN_SALT=generated
WORDPRESS_NONCE_SALT=generated

# --- outgoing mail (consumed by mu-plugins/rc-smtp.php; empty HOST = PHP mail()) ---
WORDPRESS_SMTP_HOST=
WORDPRESS_SMTP_PORT=587
WORDPRESS_SMTP_SECURE=tls
WORDPRESS_SMTP_USER=
WORDPRESS_SMTP_PASSWORD=
WORDPRESS_SMTP_FROM=no-reply@example.com
WORDPRESS_SMTP_FROM_NAME=ReserveChain

# --- backups (read by backup.sh / restore.sh; NOT used by containers) ---
# Encryption: prefer age (public-key: the server can encrypt but never decrypt).
#   age-keygen -o rc-backup.key   (keep rc-backup.key OFFLINE, e.g. password manager + sealed copy)
#   put the "age1..." public key below.
# Fallback: openssl AES-256-CBC + PBKDF2 with a passphrase file on the server (outside the backup).
BACKUP_AGE_RECIPIENT=
BACKUP_PASSPHRASE_FILE=/home/ubuntu/.config/reservechain/backup-production.pass
BACKUP_DIR=/home/ubuntu/reservechain-backups/production
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Optional off-site copy (rclone remote configured with `rclone config`, e.g. Cloudflare R2 / Backblaze B2):
RCLONE_REMOTE=
# e.g. RCLONE_REMOTE=r2:reservechain-backups
