# ReserveChain — STAGING environment (.env for ~/reservechain/staging on the server).
# Same rules as production.env.example. Staging is always noindex (X-Robots-Tag + robots.txt + blog_public=0)
# and can be password-protected with Caddy basic auth (STAGING_BASIC_AUTH below).

RC_ENV=staging
SITE_HOST=staging.reservechain.example.com
ADMIN_USER=rcadmin
ADMIN_EMAIL=ops@example.com
ADMIN_PASSWORD=generated-by-deploy
RC_FORCE_SSL_ADMIN=true

# Optional basic auth for the whole staging site (health endpoints stay reachable for uptime monitors).
# Format: user:bcrypt-hash. Generate the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'the-password'
# Use SINGLE quotes (the hash contains $).
STAGING_BASIC_AUTH=
# e.g. STAGING_BASIC_AUTH='reviewer:$2a$14$....'

# --- secrets (generated by deploy.sh; MUST differ from production) ---
DB_PASSWORD=generated-by-deploy
DB_ROOT_PASSWORD=generated-by-deploy
RC_TOKEN_SECRET=generated-64-chars
RC_DEMO_PASSWORD=choose-a-demo-password
RC_HEALTH_TOKEN=generated-by-deploy
WORDPRESS_AUTH_KEY=generated
WORDPRESS_SECURE_AUTH_KEY=generated
WORDPRESS_LOGGED_IN_KEY=generated
WORDPRESS_NONCE_KEY=generated
WORDPRESS_AUTH_SALT=generated
WORDPRESS_SECURE_AUTH_SALT=generated
WORDPRESS_LOGGED_IN_SALT=generated
WORDPRESS_NONCE_SALT=generated

# --- outgoing mail (use a sandbox such as Mailtrap / provider test mode on staging) ---
WORDPRESS_SMTP_HOST=
WORDPRESS_SMTP_PORT=587
WORDPRESS_SMTP_SECURE=tls
WORDPRESS_SMTP_USER=
WORDPRESS_SMTP_PASSWORD=
WORDPRESS_SMTP_FROM=no-reply@example.com
WORDPRESS_SMTP_FROM_NAME=ReserveChain (staging)

# --- backups ---
BACKUP_AGE_RECIPIENT=
BACKUP_PASSPHRASE_FILE=/home/ubuntu/.config/reservechain/backup-staging.pass
BACKUP_DIR=/home/ubuntu/reservechain-backups/staging
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
RCLONE_REMOTE=
