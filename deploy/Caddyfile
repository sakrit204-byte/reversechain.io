# Edge Caddyfile (shared by staging and production). Per-environment site blocks are generated by
# deploy.sh into sites/<env>.caddy from the RC_ENV / SITE_HOST / STAGING_BASIC_AUTH values in that
# environment's .env. Do not edit sites/*.caddy by hand on the server; re-run deploy.sh instead.

(rc_common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}
	@blocked path /xmlrpc.php /wp-config.php /readme.html /license.txt /wp-content/debug.log
	respond @blocked 404
}

import /etc/caddy/sites/*.caddy
