# Copy to deploy/.env on the server. NEVER commit real values.
SITE_HOST=demo.example.com          # or <server-ip>.sslip.io for an instant HTTPS hostname
RC_ENV=staging                      # development | staging | production
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
RC_TOKEN_SECRET=generate-64-random-chars
RC_DEMO_PASSWORD=choose-a-demo-password
ADMIN_USER=rcadmin
ADMIN_PASSWORD=choose-a-strong-admin-password
ADMIN_EMAIL=admin@example.com
