// =============================================================================
// ReserveChain.io — data model
//
// Every field below exists because a named requirement asks for it. Section
// references are to the client's binding documents:
//   [M§n]  ReserveChain_Final_Master_Developer_Instructions_v2.0.pdf, section n
//   [MPn]  ...the same document, Phase n
//   [W§n]  ReserveChain_Website_Developer_Instructions.pdf, section n
//
// Governing principles encoded here:
//   • Nothing commercial is hard-coded — prices, ratios, fees, thresholds,
//     allocations and jurisdiction rules are all rows, never constants. [M§12]
//   • Pending owner information never removes a field or a module; it is
//     modelled and left empty with an explicit state. [MP1..22 governing rule]
//   • Declared values and independently verified values are separate columns,
//     because the supplied certificates state that net weights are
//     "according to information given by customer".
//   • Publication of any ownership, laboratory, custody, insurance or reserve
//     claim is gated on an approval state. [M§9 Publication Control]
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared enumerations
// ─────────────────────────────────────────────────────────────────────────────

/// Content workflow states. Exactly the six the client mandates. [M§16]
/// Draft and Under Review content must never be publicly accessible, indexed
/// or exposed through public APIs; published records are unpublished or
/// archived, never hard-deleted through the standard interface.
enum PublicationState {
  DRAFT
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

/// Token-related field states. Exactly the seven required. [M§12]
enum TokenFieldState {
  PENDING
  UNDER_REVIEW
  NOT_APPLICABLE
  APPROVED
  PUBLISHED
  SUSPENDED
  RETIRED
}

/// Independent verification status of a physical asset record. [M§9]
/// NOT_VERIFIED is the default: an asset may never be labelled "Verified"
/// unless an approved independent verification actually exists. [W§8]
enum VerificationStatus {
  NOT_VERIFIED
  SUBMITTED
  IN_REVIEW
  VERIFIED
  RE_VERIFICATION_DUE
  FAILED
  NOT_APPLICABLE
}

enum CustodyStatus {
  NOT_IN_CUSTODY
  PENDING_INTAKE
  IN_TRANSIT
  IN_CUSTODY
  SEGREGATED
  RELEASED
  NOT_APPLICABLE
}

enum ReserveStatus {
  NOT_ASSESSED
  ELIGIBLE
  ALLOCATED
  RECONCILED
  EXCEPTION
  WITHDRAWN
}

enum RedemptionStatus {
  NOT_AVAILABLE
  AVAILABLE
  REQUESTED
  LOCKED
  APPROVED
  BURNED
  RELEASED
  DELIVERED
  CANCELLED
}

enum AvailabilityStatus {
  NOT_OFFERED
  PRE_LAUNCH
  PLANNED
  AVAILABLE
  SUSPENDED
  CLOSED
}

/// Physical form of an individually identifiable unit. [M§9, MP10]
/// Copper Powder arrives in glass ampoules packed in cardboard boxes;
/// Nickel Wire arrives as bobbins in a box — both are supported natively.
enum UnitKind {
  CONTAINER
  COIL
  BOBBIN
  SPOOL
  AMPOULE
  BOX
  DRUM
  PALLET
  PACKAGE
  OTHER
}

enum DocumentVisibility {
  PUBLIC
  PRIVATE
  PENDING
}

/// Categories from the future-document list. [M§14]
enum DocumentCategory {
  CORPORATE
  PROJECT_OVERVIEW
  WHITEPAPER
  TOKEN_TERMS
  RISK_DISCLOSURE
  COPPER_REPORT
  NICKEL_REPORT
  CERTIFICATE_OF_ANALYSIS
  OWNERSHIP
  VALUATION
  WAREHOUSE_CUSTODY
  INSURANCE
  PROOF_OF_RESERVES
  SMART_CONTRACT_DOC
  SMART_CONTRACT_AUDIT
  REDEMPTION_TERMS
  JURISDICTIONAL
  PRIVACY_DATA
  GOVERNANCE
  MATERIAL_EVENT
  INSPECTION
  LOGISTICS
  OTHER
}

enum JurisdictionStatus {
  UNDETERMINED
  PERMITTED
  RESTRICTED
  BLOCKED
}

enum ModuleState {
  BUILT_INACTIVE
  STAGED
  ACTIVE
  RETIRED
}

enum OwnerInputStatus {
  PENDING
  SUPPLIED
  APPROVED
  SUPERSEDED
}

enum AuditSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

enum ApprovalState {
  NONE
  PROPOSED
  APPROVED
  REJECTED
}

// =============================================================================
// PLATFORM CONFIGURATION  [M§12, M§17, M§18]
// =============================================================================

/// Every configurable platform parameter. Settings flagged `requiresApproval`
/// follow maker-checker: one administrator proposes, a different administrator
/// approves. This covers "no hard-coded percentage, price, spread, fee or
/// discount that cannot be changed by an authorised issuer administrator" and
/// "maker-checker approval for material commercial configuration changes".
model Setting {
  id               BigInt        @id @default(autoincrement())
  key              String        @unique @db.VarChar(191)
  group            String        @default("general") @db.VarChar(64)
  valueJson        String?       @map("value_json") @db.LongText
  valueType        String        @default("string") @map("value_type") @db.VarChar(32)
  label            String?       @db.VarChar(255)
  description      String?       @db.Text
  requiresApproval Boolean       @default(false) @map("requires_approval")
  approvalState    ApprovalState @default(NONE) @map("approval_state")
  pendingValueJson String?       @map("pending_value_json") @db.LongText
  proposedById     BigInt?       @map("proposed_by_id")
  proposedAt       DateTime?     @map("proposed_at")
  approvedById     BigInt?       @map("approved_by_id")
  approvedAt       DateTime?     @map("approved_at")
  /// Secret values are never returned by any read API and never rendered.
  isSecret         Boolean       @default(false) @map("is_secret")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([group])
  @@map("rc_settings")
}

/// Website modes. [M§18] Live Offering, token purchase, wallet, payment,
/// eligibility and redemption "must require explicit authorized administrative
/// and deployment actions. They must never activate automatically."
model SiteMode {
  id                      BigInt        @id @default(autoincrement())
  key                     String        @unique @db.VarChar(64)
  label                   String        @db.VarChar(191)
  description             String?       @db.Text
  isActive                Boolean       @default(false) @map("is_active")
  /// High-risk modes cannot be toggled by a single administrator.
  isHighRisk              Boolean       @default(true) @map("is_high_risk")
  requiresWrittenAuth     Boolean       @default(true) @map("requires_written_authorization")
  authorizationReference  String?       @map("authorization_reference") @db.VarChar(255)
  approvalState           ApprovalState @default(NONE) @map("approval_state")
  proposedState           Boolean?      @map("proposed_state")
  proposedById            BigInt?       @map("proposed_by_id")
  proposedAt              DateTime?     @map("proposed_at")
  approvedById            BigInt?       @map("approved_by_id")
  approvedAt              DateTime?     @map("approved_at")
  activatedAt             DateTime?     @map("activated_at")
  deactivatedAt           DateTime?     @map("deactivated_at")
  sortOrder               Int           @default(0) @map("sort_order")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  @@map("rc_site_modes")
}

/// Module visibility. [M§17] Modules are built complete but stay hidden,
/// inactive and non-indexable until expressly authorised.
model ModuleFlag {
  id             BigInt      @id @default(autoincrement())
  key            String      @unique @db.VarChar(64)
  label          String      @db.VarChar(191)
  description    String?     @db.Text
  state          ModuleState @default(BUILT_INACTIVE)
  isPublic       Boolean     @default(false) @map("is_public")
  isIndexable    Boolean     @default(false) @map("is_indexable")
  dependsOnMode  String?     @map("depends_on_mode") @db.VarChar(64)
  activationNote String?     @map("activation_note") @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@map("rc_module_flags")
}

/// Versioned legal notices and disclosures, including the mandatory no-offer
/// disclosure. [M§4] Never hard-coded, so legal review can revise wording
/// without a deployment.
model LegalNotice {
  id               BigInt           @id @default(autoincrement())
  key              String           @db.VarChar(64)
  locale           String           @default("en") @db.VarChar(10)
  version          Int              @default(1)
  title            String           @db.VarChar(255)
  body             String           @db.LongText
  sourceReference  String?          @map("source_reference") @db.VarChar(255)
  publicationState PublicationState @default(DRAFT) @map("publication_state")
  effectiveFrom    DateTime?        @map("effective_from")
  effectiveTo      DateTime?        @map("effective_to")
  approvedById     BigInt?          @map("approved_by_id")
  approvedAt       DateTime?        @map("approved_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@unique([key, locale, version])
  @@index([key, publicationState])
  @@map("rc_legal_notices")
}

/// Jurisdiction controls. [M§5] Permitted/restricted lists, EU/EEA flagging,
/// enhanced due diligence and investor classification are all data.
/// Default is UNDETERMINED — the permitted list is owner/adviser input that
/// has not yet been supplied, and we do not invent it.
model Jurisdiction {
  id                              BigInt             @id @default(autoincrement())
  countryCode                     String             @unique @map("country_code") @db.Char(2)
  countryName                     String             @map("country_name") @db.VarChar(128)
  region                          String?            @db.VarChar(64)
  status                          JurisdictionStatus @default(UNDETERMINED)
  isEuEea                         Boolean            @default(false) @map("is_eu_eea")
  requiresEnhancedDueDiligence    Boolean            @default(false) @map("requires_enhanced_dd")
  investorClassificationRequired  String?            @map("investor_classification_required") @db.VarChar(128)
  notes                           String?            @db.Text
  sourceReference                 String?            @map("source_reference") @db.VarChar(255)
  decidedById                     BigInt?            @map("decided_by_id")
  decidedAt                       DateTime?          @map("decided_at")
  createdAt                       DateTime           @default(now()) @map("created_at")
  updatedAt                       DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@map("rc_jurisdictions")
}

/// Owner-input register. [Master Part III §B] Tracks every input the project
/// owner or appointed advisers must supply, with status, source, version,
/// approval authority and the components it unblocks.
model OwnerInput {
  id                 BigInt           @id @default(autoincrement())
  category           String           @db.VarChar(64)
  key                String           @unique @db.VarChar(128)
  requiredInput      String           @map("required_input") @db.Text
  status             OwnerInputStatus @default(PENDING)
  source             String?          @db.VarChar(255)
  version            String?          @db.VarChar(64)
  approvalAuthority  String?          @map("approval_authority") @db.VarChar(191)
  affectedComponents String?          @map("affected_components") @db.Text
  suppliedAt         DateTime?        @map("supplied_at")
  approvedAt         DateTime?        @map("approved_at")
  notes              String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@index([category, status])
  @@map("rc_owner_inputs")
}

// =============================================================================
// IDENTITY, ACCESS AND SECURITY  [M§16 Administrator Security, MP5, MP9]
// =============================================================================

/// Administrative and participant accounts. Editors, reviewers, compliance
/// users and system administrators are separated by role. [M§16]
model User {
  id                   BigInt    @id @default(autoincrement())
  email                String    @unique @db.VarChar(191)
  emailVerifiedAt      DateTime? @map("email_verified_at")
  /// argon2id. Never a reversible hash, never stored alongside a pepper in code.
  passwordHash         String?   @map("password_hash") @db.VarChar(255)
  passwordUpdatedAt    DateTime? @map("password_updated_at")
  firstName            String?   @map("first_name") @db.VarChar(128)
  lastName             String?   @map("last_name") @db.VarChar(128)
  displayName          String?   @map("display_name") @db.VarChar(191)
  locale               String    @default("en") @db.VarChar(10)
  isAdmin              Boolean   @default(false) @map("is_admin")
  /// Immediate account deactivation is a named requirement. [M§16]
  isActive             Boolean   @default(true) @map("is_active")
  deactivatedAt        DateTime? @map("deactivated_at")
  deactivatedReason    String?   @map("deactivated_reason") @db.VarChar(255)
  mfaEnforced          Boolean   @default(false) @map("mfa_enforced")
  lastLoginAt          DateTime? @map("last_login_at")
  lastLoginIp          Bytes?    @map("last_login_ip") @db.VarBinary(16)
  failedLoginCount     Int       @default(0) @map("failed_login_count")
  lockedUntil          DateTime? @map("locked_until")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  roles          UserRole[]
  sessions       Session[]
  mfaCredentials MfaCredential[]
  participant    Participant?

  @@index([isActive])
  @@map("rc_users")
}

/// Roles are rows so the client can add one without a deployment.
/// Seeded: super_admin, operations, compliance, finance, treasury, support,
/// content_editor, content_reviewer, auditor (read-only), participant. [MP9]
model Role {
  id          BigInt     @id @default(autoincrement())
  key         String     @unique @db.VarChar(64)
  label       String     @db.VarChar(128)
  description String?    @db.Text
  /// JSON array of permission strings, e.g. ["registry.lot.update", ...]
  permissions String     @db.LongText
  isSystem    Boolean    @default(false) @map("is_system")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  users UserRole[]

  @@map("rc_roles")
}

model UserRole {
  userId     BigInt   @map("user_id")
  roleId     BigInt   @map("role_id")
  grantedById BigInt? @map("granted_by_id")
  grantedAt  DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("rc_user_roles")
}

/// Server-side sessions with rotation. Supports "secure session management",
/// "session expiration", "device and session controls" and the participant
/// "session management" screen. [MP5, MP8]
model Session {
  id             String    @id @db.Char(36)
  userId         BigInt    @map("user_id")
  /// SHA-256 of the refresh token; the raw token is never stored.
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  previousTokenHash String? @map("previous_token_hash") @db.Char(64)
  ipAddress      Bytes?    @map("ip_address") @db.VarBinary(16)
  userAgent      String?   @map("user_agent") @db.VarChar(255)
  deviceLabel    String?   @map("device_label") @db.VarChar(128)
  mfaSatisfied   Boolean   @default(false) @map("mfa_satisfied")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  revokedReason  String?   @map("revoked_reason") @db.VarChar(128)
  lastSeenAt     DateTime? @map("last_seen_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("rc_sessions")
}

/// TOTP credentials and single-use recovery codes. [MP5 two-factor auth]
model MfaCredential {
  id           BigInt    @id @default(autoincrement())
  userId       BigInt    @map("user_id")
  type         String    @default("totp") @db.VarChar(32)
  label        String?   @db.VarChar(128)
  /// Encrypted at rest with the application key; never returned by any API.
  secretCipher String    @map("secret_cipher") @db.VarChar(512)
  confirmedAt  DateTime? @map("confirmed_at")
  lastUsedAt   DateTime? @map("last_used_at")
  /// Hashes of unused recovery codes (JSON array).
  recoveryCodes String?  @map("recovery_codes") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("rc_mfa_credentials")
}

/// Login-attempt protection. [M§16]
model LoginAttempt {
  id          BigInt   @id @default(autoincrement())
  email       String?  @db.VarChar(191)
  ipAddress   Bytes?   @map("ip_address") @db.VarBinary(16)
  successful  Boolean  @default(false)
  failureCode String?  @map("failure_code") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  attemptedAt DateTime @default(now()) @map("attempted_at")

  @@index([email, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@map("rc_login_attempts")
}

// =============================================================================
// AUDIT TRAIL  [M§16]
//
// "A complete append-only and tamper-evident administrative audit trail is
//  mandatory. Audit records must not be editable or removable through the
//  standard administrative interface."
//
// Four independent defences, so the guarantee does not rest on application
// code alone:
//   1. No update or delete path exists in the API.
//   2. The application database user holds INSERT and SELECT only on this
//      table (infra/docker/mysql-init/10-grants.sql).
//   3. BEFORE UPDATE / BEFORE DELETE triggers raise SQLSTATE '45000', so even
//      a direct SQL statement from a privileged session is rejected.
//   4. Each row chains to its predecessor:
//        rowHash = SHA256( prevHash || canonicalJson(payload) )
//      and a daily Merkle root is anchored on-chain, so tampering remains
//      detectable to an outside auditor even with full database access.
// =============================================================================

model AuditLog {
  id            BigInt        @id @default(autoincrement())
  occurredAt    DateTime      @map("occurred_at") @db.DateTime(6)
  actorUserId   BigInt?       @map("actor_user_id")
  actorLabel    String?       @map("actor_label") @db.VarChar(191)
  actorRoles    String?       @map("actor_roles") @db.VarChar(255)
  actorIp       Bytes?        @map("actor_ip") @db.VarBinary(16)
  actorUserAgent String?      @map("actor_user_agent") @db.VarChar(255)
  requestId     String?       @map("request_id") @db.Char(36)
  /// create | update | state_change | publish | unpublish | archive | approve |
  /// reject | upload | replace | download | export | login_success |
  /// login_failure | role_change | mode_change | setting_change | anchor
  action        String        @db.VarChar(64)
  entityType    String        @map("entity_type") @db.VarChar(64)
  entityId      BigInt?       @map("entity_id")
  entityLabel   String?       @map("entity_label") @db.VarChar(255)
  field         String?       @db.VarChar(191)
  previousValue String?       @map("previous_value") @db.LongText
  newValue      String?       @map("new_value") @db.LongText
  /// Required for material changes. [M§16 "Reason for material changes"]
  reason        String?       @db.Text
  severity      AuditSeverity @default(INFO)
  prevHash      String        @map("prev_hash") @db.Char(64)
  rowHash       String        @unique @map("row_hash") @db.Char(64)

  @@index([occurredAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([action])
  @@map("rc_audit_log")
}

/// Single-row head pointer for the audit hash chain.
///
/// Appending to the chain requires reading the current head, deriving the next
/// hash from it, and advancing it — which must not interleave across
/// concurrent requests or the chain forks. Serialising on `SELECT ... FOR
/// UPDATE` of this row inside the same transaction as the insert makes the
/// append atomic and connection-safe, which a MySQL advisory lock would not be
/// under a connection pool.
model AuditChainHead {
  id         Int      @id @default(1)
  headHash   String   @map("head_hash") @db.Char(64)
  entryCount BigInt   @default(0) @map("entry_count")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("rc_audit_chain_head")
}

/// Daily Merkle anchors of the audit chain, published to ReserveAttestationRegistry.
model AuditAnchor {
  id             BigInt    @id @default(autoincrement())
  periodStart    DateTime  @map("period_start") @db.DateTime(6)
  periodEnd      DateTime  @map("period_end") @db.DateTime(6)
  firstAuditId   BigInt    @map("first_audit_id")
  lastAuditId    BigInt    @map("last_audit_id")
  entryCount     Int       @map("entry_count")
  merkleRoot     String    @map("merkle_root") @db.Char(66)
  chainId        Int?      @map("chain_id")
  contractAddress String?  @map("contract_address") @db.Char(42)
  txHash         String?   @map("tx_hash") @db.Char(66)
  blockNumber    BigInt?   @map("block_number")
  anchoredAt     DateTime? @map("anchored_at")
  status         String    @default("pending") @db.VarChar(32)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([periodStart, periodEnd])
  @@index([status])
  @@map("rc_audit_anchors")
}

/// Full JSON snapshot per record version — "record versioning" and
/// "complete change and approval history". [M§9, MP10]
model RecordRevision {
  id               BigInt    @id @default(autoincrement())
  entityType       String    @map("entity_type") @db.VarChar(64)
  entityId         BigInt    @map("entity_id")
  version          Int
  snapshotJson     String    @map("snapshot_json") @db.LongText
  publicationState String?   @map("publication_state") @db.VarChar(32)
  changedById      BigInt?   @map("changed_by_id")
  changeReason     String?   @map("change_reason") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId])
  @@map("rc_record_revisions")
}

// =============================================================================
// DOCUMENTS AND MEDIA  [M§9, M§14, MP10]
// =============================================================================

/// Every uploaded file. Stored in private object storage; served only through
/// signed, permission-checked URLs. The SHA-256 digest supports
/// "asset-document hashes or evidence references" [MP10] and powers the public
/// document verifier: anyone holding a copy of a certificate can confirm it is
/// byte-identical to the record the platform relies on.
model Document {
  id               BigInt             @id @default(autoincrement())
  publicId         String             @unique @map("public_id") @db.Char(26)
  category         DocumentCategory   @default(OTHER)
  title            String             @db.VarChar(255)
  description      String?            @db.Text
  /// Storage key in the object store. Never a public URL.
  storageKey       String             @map("storage_key") @db.VarChar(512)
  originalFilename String             @map("original_filename") @db.VarChar(255)
  mimeType         String             @map("mime_type") @db.VarChar(128)
  byteSize         BigInt             @map("byte_size")
  sha256           String             @db.Char(64)
  /// Documents are versioned; replacing a file creates a new version and the
  /// previous version is retained (historical-document archive). [M§14]
  version          Int                @default(1)
  supersedesId     BigInt?            @map("supersedes_id")
  visibility       DocumentVisibility @default(PENDING)
  publicationState PublicationState   @default(DRAFT) @map("publication_state")
  /// Issue and expiry drive the "expiring-document alerts". [MP11]
  issuedOn         DateTime?          @map("issued_on") @db.Date
  expiresOn        DateTime?          @map("expires_on") @db.Date
  issuer           String?            @db.VarChar(191)
  documentNumber   String?            @map("document_number") @db.VarChar(128)
  locale           String?            @db.VarChar(10)
  /// Media-usage rights and alternative text are named requirements. [M§9]
  usageRights      String?            @map("usage_rights") @db.VarChar(255)
  altText          String?            @map("alt_text") @db.VarChar(512)
  sourceReference  String?            @map("source_reference") @db.VarChar(255)
  uploadedById     BigInt?            @map("uploaded_by_id")
  approvedById     BigInt?            @map("approved_by_id")
  approvedAt       DateTime?          @map("approved_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  supersedes  Document?  @relation("DocumentVersions", fields: [supersedesId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersededBy Document[] @relation("DocumentVersions")
  links       DocumentLink[]
  certificates Certificate[]

  @@index([category, publicationState])
  @@index([sha256])
  @@index([expiresOn])
  @@map("rc_documents")
}

/// Polymorphic attachment of a document to any registry entity.
model DocumentLink {
  id         BigInt   @id @default(autoincrement())
  documentId BigInt   @map("document_id")
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   BigInt   @map("entity_id")
  role       String?  @db.VarChar(64)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, entityType, entityId, role])
  @@index([entityType, entityId])
  @@map("rc_document_links")
}

/// Image and video gallery entries. [M§9 media gallery, videos]
model MediaAsset {
  id               BigInt           @id @default(autoincrement())
  entityType       String           @map("entity_type") @db.VarChar(64)
  entityId         BigInt           @map("entity_id")
  kind             String           @default("image") @db.VarChar(32)
  storageKey       String           @map("storage_key") @db.VarChar(512)
  mimeType         String           @map("mime_type") @db.VarChar(128)
  width            Int?
  height           Int?
  byteSize         BigInt?          @map("byte_size")
  sha256           String?          @db.Char(64)
  caption          String?          @db.VarChar(512)
  altText          String?          @map("alt_text") @db.VarChar(512)
  /// Distinguishes approved photographic evidence from illustrative or
  /// conceptual imagery. Concept art may never stand in as proof of
  /// ownership, custody, certification or reserves. [W§2, W§8]
  isRealPhotograph Boolean          @default(false) @map("is_real_photograph")
  isIllustrative   Boolean          @default(true) @map("is_illustrative")
  usageRights      String?          @map("usage_rights") @db.VarChar(255)
  sortOrder        Int              @default(0) @map("sort_order")
  publicationState PublicationState @default(DRAFT) @map("publication_state")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([entityType, entityId, sortOrder])
  @@map("rc_media_assets")
}

// =============================================================================
// INDUSTRIAL METALS REGISTRY  [M§9, M§10, M§11, MP10]
//
// Hierarchy:  AssetProgram → Lot → Unit (container / coil / bobbin / ampoule)
// Each level carries its own documents, custody, valuation and reserve state,
// because the client requires container-by-container and coil-by-coil
// identification, reconciliation and redemption control.
// =============================================================================

model AssetProgram {
  id            BigInt @id @default(autoincrement())
  /// Unique asset-program identifier. [M§9]
  programCode   String @unique @map("program_code") @db.VarChar(64)
  slug          String @unique @db.VarChar(191)
  name          String @db.VarChar(191)
  /// e.g. "Industrial Metal", "Precious Metal", "Gemstone" — the architecture
  /// must expand to future approved asset classes without a rebuild. [M§2]
  assetClass    String @map("asset_class") @db.VarChar(64)
  materialCategory String @map("material_category") @db.VarChar(64)
  /// powder | wire | coil | bar | ingot | cathode ...
  materialForm  String @map("material_form") @db.VarChar(64)
  productName   String @map("product_name") @db.VarChar(191)
  summary       String? @db.Text
  description   String? @db.LongText

  /// Declared purity, and separately the independently tested purity. [MP10]
  declaredPurityPct Decimal? @map("declared_purity_pct") @db.Decimal(12, 6)
  testedPurityPct   Decimal? @map("tested_purity_pct") @db.Decimal(12, 6)
  purityStandard    String?  @map("purity_standard") @db.VarChar(191)

  publicationState   PublicationState   @default(DRAFT) @map("publication_state")
  availabilityStatus AvailabilityStatus @default(PRE_LAUNCH) @map("availability_status")
  verificationStatus VerificationStatus @default(NOT_VERIFIED) @map("verification_status")
  custodyStatus      CustodyStatus      @default(NOT_APPLICABLE) @map("custody_status")
  reserveStatus      ReserveStatus      @default(NOT_ASSESSED) @map("reserve_status")
  tokenizationStatus TokenFieldState    @default(PENDING) @map("tokenization_status")
  redemptionStatus   RedemptionStatus   @default(NOT_AVAILABLE) @map("redemption_status")

  /// Future categories must be unmistakably marked and must never be mixed
  /// into current reserve totals or active program statistics. [W§6, W§8]
  isFutureCategory Boolean @default(false) @map("is_future_category")

  /// Jurisdictional restrictions specific to this program. [M§9]
  jurisdictionNotes String? @map("jurisdiction_notes") @db.Text

  sortOrder Int      @default(0) @map("sort_order")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  approvedById BigInt? @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  publishedAt  DateTime? @map("published_at")
  archivedAt   DateTime? @map("archived_at")

  lots          Lot[]
  specFields    ProgramSpecField[]
  translations  ProgramTranslation[]
  tokenPrograms TokenProgram[]
  reserveLines  ReserveLine[]

  @@index([publicationState, isFutureCategory])
  @@map("rc_asset_programs")
}

/// Typed, per-program specification fields. Copper Powder needs particle-size
/// distribution, morphology, apparent and tap density, oxygen and moisture
/// content and flow characteristics; Nickel Wire needs diameter, gauge,
/// tolerance, coil length, surface finish, temper, tensile strength,
/// elongation and electrical characteristics. [M§10, M§11]
/// Holding these as typed rows means a third metal — or a gemstone — needs a
/// configuration change, not a migration.
model ProgramSpecField {
  id           BigInt  @id @default(autoincrement())
  programId    BigInt  @map("program_id")
  groupKey     String  @map("group_key") @db.VarChar(64)
  key          String  @db.VarChar(128)
  label        String  @db.VarChar(191)
  /// string | number | decimal | range | boolean | date | enum | document
  dataType     String  @map("data_type") @db.VarChar(32)
  unit         String? @db.VarChar(32)
  /// Whether this field may be shown publicly once approved.
  isPublic     Boolean @default(true) @map("is_public")
  isRequired   Boolean @default(false) @map("is_required")
  sortOrder    Int     @default(0) @map("sort_order")
  helpText     String? @map("help_text") @db.Text

  program AssetProgram        @relation(fields: [programId], references: [id], onDelete: Cascade)
  values  ProgramSpecValue[]

  @@unique([programId, key])
  @@index([programId, groupKey, sortOrder])
  @@map("rc_program_spec_fields")
}

/// A specification value attached to a program, lot or unit.
model ProgramSpecValue {
  id          BigInt           @id @default(autoincrement())
  fieldId     BigInt           @map("field_id")
  entityType  String           @map("entity_type") @db.VarChar(32)
  entityId    BigInt           @map("entity_id")
  valueText   String?          @map("value_text") @db.Text
  valueNumber Decimal?         @map("value_number") @db.Decimal(28, 10)
  valueMin    Decimal?         @map("value_min") @db.Decimal(28, 10)
  valueMax    Decimal?         @map("value_max") @db.Decimal(28, 10)
  valueDate   DateTime?        @map("value_date") @db.Date
  valueBool   Boolean?         @map("value_bool")
  /// Where the value came from — a certificate, a datasheet, an inspection.
  sourceReference String?      @map("source_reference") @db.VarChar(255)
  sourceDocumentId BigInt?     @map("source_document_id")
  publicationState PublicationState @default(DRAFT) @map("publication_state")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  field ProgramSpecField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("rc_program_spec_values")
}

/// Multilingual content: English, Spanish and Italian are mandatory.
model ProgramTranslation {
  id          BigInt @id @default(autoincrement())
  programId   BigInt @map("program_id")
  locale      String @db.VarChar(10)
  name        String? @db.VarChar(191)
  summary     String? @db.Text
  description String? @db.LongText
  /// SEO metadata per locale. [M§9, M§19]
  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.VarChar(512)
  publicationState PublicationState @default(DRAFT) @map("publication_state")

  program AssetProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, locale])
  @@map("rc_program_translations")
}

/// A lot or batch of material. [M§9, M§10, M§11]
model Lot {
  id          BigInt @id @default(autoincrement())
  programId   BigInt @map("program_id")
  /// Unique lot / batch identifier, e.g. "03-K-07" or "120/NP1".
  lotNumber   String @map("lot_number") @db.VarChar(128)
  slug        String @unique @db.VarChar(191)

  /// Quantity as DECLARED by the supplier, and as INDEPENDENTLY VERIFIED.
  /// Kept apart deliberately: the supplied certificates state that net weight
  /// is "according to information given by customer", which is a declaration,
  /// not a verification. Public surfaces must never present one as the other.
  declaredQuantity   Decimal? @map("declared_quantity") @db.Decimal(24, 6)
  verifiedQuantity   Decimal? @map("verified_quantity") @db.Decimal(24, 6)
  quantityUnit       String?  @map("quantity_unit") @db.VarChar(16)
  declaredGrossWeight Decimal? @map("declared_gross_weight") @db.Decimal(24, 6)
  declaredNetWeight   Decimal? @map("declared_net_weight") @db.Decimal(24, 6)
  verifiedNetWeight   Decimal? @map("verified_net_weight") @db.Decimal(24, 6)
  weightUnit          String?  @map("weight_unit") @db.VarChar(16)
  quantitySource      String?  @map("quantity_source") @db.VarChar(191)
  unitCount           Int?     @map("unit_count")

  packagingType   String? @map("packaging_type") @db.VarChar(191)
  sealNumbers     String? @map("seal_numbers") @db.Text
  storageRequirements String? @map("storage_requirements") @db.Text
  handlingRequirements String? @map("handling_requirements") @db.Text

  producer        String?   @db.VarChar(191)
  supplier        String?   @db.VarChar(191)
  countryOfOrigin String?   @map("country_of_origin") @db.Char(2)
  countryOfManufacture String? @map("country_of_manufacture") @db.Char(2)
  productionDate  DateTime? @map("production_date") @db.Date
  acquisitionDate DateTime? @map("acquisition_date") @db.Date

  declaredPurityPct Decimal? @map("declared_purity_pct") @db.Decimal(12, 6)
  testedPurityPct   Decimal? @map("tested_purity_pct") @db.Decimal(12, 6)
  impurityPct       Decimal? @map("impurity_pct") @db.Decimal(12, 6)
  purityStandard    String?  @map("purity_standard") @db.VarChar(191)

  publicationState   PublicationState   @default(DRAFT) @map("publication_state")
  verificationStatus VerificationStatus @default(NOT_VERIFIED) @map("verification_status")
  custodyStatus      CustodyStatus      @default(NOT_APPLICABLE) @map("custody_status")
  reserveStatus      ReserveStatus      @default(NOT_ASSESSED) @map("reserve_status")
  tokenizationStatus TokenFieldState    @default(PENDING) @map("tokenization_status")
  redemptionStatus   RedemptionStatus   @default(NOT_AVAILABLE) @map("redemption_status")

  /// Encumbrance, lien and restriction status. [MP10]
  encumbranceStatus String? @map("encumbrance_status") @db.VarChar(64)
  encumbranceNotes  String? @map("encumbrance_notes") @db.Text

  notes     String?  @db.Text
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  approvedById BigInt? @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  publishedAt  DateTime? @map("published_at")
  archivedAt   DateTime? @map("archived_at")

  program      AssetProgram      @relation(fields: [programId], references: [id], onDelete: Restrict)
  units        Unit[]
  certificates Certificate[]
  ownership    OwnershipRecord[]
  custody      CustodyRecord[]
  insurance    InsuranceRecord[]
  valuations   Valuation[]
  events       MaterialEvent[]
  reserveLines ReserveLine[]

  @@unique([programId, lotNumber])
  @@index([publicationState])
  @@index([reserveStatus])
  @@map("rc_lots")
}

/// An individually identifiable physical unit — the level at which the client
/// requires "container-by-container identification, inventory reconciliation
/// and redemption controls" and "individual coil identification … and
/// coil-by-coil redemption". [M§10, M§11]
model Unit {
  id         BigInt   @id @default(autoincrement())
  lotId      BigInt   @map("lot_id")
  kind       UnitKind @default(CONTAINER)
  /// Container / coil / bobbin identifier as marked on the physical unit.
  identifier String   @db.VarChar(128)
  sequenceNo Int?     @map("sequence_no")

  declaredNetWeight Decimal? @map("declared_net_weight") @db.Decimal(24, 6)
  verifiedNetWeight Decimal? @map("verified_net_weight") @db.Decimal(24, 6)
  grossWeight       Decimal? @map("gross_weight") @db.Decimal(24, 6)
  weightUnit        String?  @map("weight_unit") @db.VarChar(16)

  packagingType   String? @map("packaging_type") @db.VarChar(191)
  packagingCondition String? @map("packaging_condition") @db.VarChar(191)
  sealNumber      String? @map("seal_number") @db.VarChar(128)
  storageLocation String? @map("storage_location") @db.VarChar(255)
  storageZone     String? @map("storage_zone") @db.VarChar(128)

  /// Whether this individual unit was sampled during assay. The supplied
  /// nickel certificate records sampling from bobbins 8, 10, 19 and 27, and
  /// the copper certificate from box 20 — that provenance is preserved here.
  wasSampled      Boolean   @default(false) @map("was_sampled")
  sampledAt       DateTime? @map("sampled_at") @db.Date

  publicationState   PublicationState   @default(DRAFT) @map("publication_state")
  verificationStatus VerificationStatus @default(NOT_VERIFIED) @map("verification_status")
  custodyStatus      CustodyStatus      @default(NOT_APPLICABLE) @map("custody_status")
  reserveStatus      ReserveStatus      @default(NOT_ASSESSED) @map("reserve_status")
  redemptionStatus   RedemptionStatus   @default(NOT_AVAILABLE) @map("redemption_status")
  /// Archive / withdrawal / suspension / retirement status. [MP10]
  lifecycleStatus    String?            @map("lifecycle_status") @db.VarChar(64)

  notes     String?  @db.Text
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  lot       Lot        @relation(fields: [lotId], references: [id], onDelete: Restrict)
  passport  Passport?
  events    MaterialEvent[]
  custody   CustodyRecord[]
  reserveLines ReserveLine[]
  redemptionUnits RedemptionUnit[]

  @@unique([lotId, identifier])
  @@index([reserveStatus])
  @@index([redemptionStatus])
  @@map("rc_units")
}

/// Testing, assay and inspection providers. [MP10]
model Laboratory {
  id               BigInt           @id @default(autoincrement())
  name             String           @db.VarChar(191)
  slug             String           @unique @db.VarChar(191)
  /// laboratory | inspector | appraiser | auditor
  providerType     String           @default("laboratory") @map("provider_type") @db.VarChar(32)
  addressLine      String?          @map("address_line") @db.VarChar(255)
  city             String?          @db.VarChar(128)
  countryCode      String?          @map("country_code") @db.Char(2)
  website          String?          @db.VarChar(255)
  contactEmail     String?          @map("contact_email") @db.VarChar(191)
  registrationNumber String?        @map("registration_number") @db.VarChar(128)
  /// Accreditation claims stay unpublished until evidence is supplied and
  /// approved. We never display an accreditation we have not been shown. [M§3]
  accreditationBody String?         @map("accreditation_body") @db.VarChar(191)
  accreditationRef  String?         @map("accreditation_ref") @db.VarChar(128)
  accreditationVerified Boolean     @default(false) @map("accreditation_verified")
  isIndependent    Boolean          @default(false) @map("is_independent")
  publicationState PublicationState @default(DRAFT) @map("publication_state")
  notes            String?          @db.Text
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  certificates Certificate[]

  @@map("rc_laboratories")
}

/// A Certificate of Analysis / assay report. [M§10, M§11, MP10]
model Certificate {
  id                BigInt   @id @default(autoincrement())
  laboratoryId      BigInt?  @map("laboratory_id")
  lotId             BigInt?  @map("lot_id")
  certificateNumber String   @map("certificate_number") @db.VarChar(128)
  certificateDate   DateTime? @map("certificate_date") @db.Date
  sampleDate        DateTime? @map("sample_date") @db.Date
  /// e.g. "ICP/MS and ICP/OES"
  testMethod        String?  @map("test_method") @db.VarChar(191)
  /// e.g. "GOST 2179-75", "TU 1793-011-50316079-2004"
  standardReference String?  @map("standard_reference") @db.VarChar(191)
  goodsDescription  String?  @map("goods_description") @db.VarChar(512)
  sampleDescription String?  @map("sample_description") @db.VarChar(512)
  sampleLocation    String?  @map("sample_location") @db.VarChar(255)
  /// Which physical units were sampled, e.g. bobbins 8/10/19/27, box 20.
  sampledUnits      String?  @map("sampled_units") @db.VarChar(512)

  purityPct    Decimal? @map("purity_pct") @db.Decimal(12, 6)
  impurityPct  Decimal? @map("impurity_pct") @db.Decimal(12, 6)
  /// Free-text findings that are not element concentrations, e.g. isotopic
  /// composition or a radioactivity statement.
  additionalFindings String? @map("additional_findings") @db.Text

  documentId BigInt? @map("document_id")

  publicationState   PublicationState   @default(DRAFT) @map("publication_state")
  verificationStatus VerificationStatus @default(NOT_VERIFIED) @map("verification_status")
  /// Re-verification cadence drives the stale-attestation alert. [MP11]
  validUntil DateTime? @map("valid_until") @db.Date

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  approvedById BigInt? @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")

  laboratory Laboratory?          @relation(fields: [laboratoryId], references: [id], onDelete: SetNull)
  lot        Lot?                 @relation(fields: [lotId], references: [id], onDelete: Restrict)
  document   Document?            @relation(fields: [documentId], references: [id], onDelete: SetNull)
  elements   CertificateElement[]

  @@unique([laboratoryId, certificateNumber])
  @@index([lotId])
  @@index([publicationState])
  @@map("rc_certificates")
}

/// One measured element concentration from a certificate. Modelling the assay
/// table row-by-row lets the platform reproduce the certificate faithfully,
/// compare lots, and recompute impurity totals rather than restating a number
/// typed in by hand.
model CertificateElement {
  id            BigInt   @id @default(autoincrement())
  certificateId BigInt   @map("certificate_id")
  element       String   @db.VarChar(8)
  /// "<" when the laboratory reports a detection-limit bound, "=" otherwise.
  operator      String   @default("=") @db.VarChar(2)
  valuePpm      Decimal? @map("value_ppm") @db.Decimal(20, 6)
  /// Set when the element is the base material rather than an impurity.
  isMatrix      Boolean  @default(false) @map("is_matrix")
  sortOrder     Int      @default(0) @map("sort_order")

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@unique([certificateId, element])
  @@map("rc_certificate_elements")
}

/// Ownership and chain-of-title records. [M§9, MP10]
model OwnershipRecord {
  id               BigInt           @id @default(autoincrement())
  lotId            BigInt           @map("lot_id")
  ownerName        String           @map("owner_name") @db.VarChar(191)
  ownerType        String?          @map("owner_type") @db.VarChar(64)
  ownerCountry     String?          @map("owner_country") @db.Char(2)
  /// purchase | assignment | contribution | transfer
  acquisitionType  String?          @map("acquisition_type") @db.VarChar(64)
  effectiveFrom    DateTime?        @map("effective_from") @db.Date
  effectiveTo      DateTime?        @map("effective_to") @db.Date
  titleReference   String?          @map("title_reference") @db.VarChar(191)
  publicationState PublicationState @default(DRAFT) @map("publication_state")
  verificationStatus VerificationStatus @default(NOT_VERIFIED) @map("verification_status")
  notes            String?          @db.Text
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([lotId, effectiveFrom])
  @@map("rc_ownership_records")
}

/// Custodians, warehouses and vault operators. [MP10, M§17]
model Custodian {
  id               BigInt           @id @default(autoincrement())
  name             String           @db.VarChar(191)
  slug             String           @unique @db.VarChar(191)
  facilityType     String?          @map("facility_type") @db.VarChar(64)
  addressLine      String?          @map("address_line") @db.VarChar(255)
  city             String?          @db.VarChar(128)
  countryCode      String?          @map("country_code") @db.Char(2)
  registrationNumber String?        @map("registration_number") @db.VarChar(128)
  agreementReference String?        @map("agreement_reference") @db.VarChar(191)
  /// Custody arrangements are owner input. Until an agreement is supplied and
  /// approved, no custodian may be presented publicly. [M§1, M§3]
  publicationState PublicationState @default(DRAFT) @map("publication_state")
  notes            String?          @db.Text
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  custodyRecords CustodyRecord[]

  @@map("rc_custodians")
}

/// Chain-of-custody, movement and transfer history. [MP10]
model CustodyRecord {
  id               BigInt           @id @default(autoincrement())
  custodianId      BigInt?          @map("custodian_id")
  lotId            BigInt?          @map("lot_id")
  unitId           BigInt?          @map("unit_id")
  /// intake | transfer | inspection | segregation | release | movement
  eventType        String           @map("event_type") @db.VarChar(64)
  status           CustodyStatus    @default(PENDING_INTAKE)
  locationLabel    String?          @map("location_label") @db.VarChar(255)
  warehouseReceiptRef String?       @map("warehouse_receipt_ref") @db.VarChar(191)
  isSegregated     Boolean          @default(false) @map("is_segregated")
  occurredAt       DateTime?        @map("occurred_at")
  recordedAt       DateTime         @default(now()) @map("recorded_at")
  publicationState PublicationState @default(DRAFT) @map("publication_state")
  notes            String?          @db.Text

  custodian Custodian? @relation(fields: [custodianId], references: [id], onDelete: SetNull)
  lot       Lot?       @relation(fields: [lotId], references: [id], onDelete: Restrict)
  unit      Unit?      @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([lotId, occurredAt])
  @@index([unitId, occurredAt])
  @@map("rc_custody_records")
}

/// Insurance cover. [M§9, MP10] Never displayed as confirmed until the policy
/// document is supplied and approved. [M§1]
model InsuranceRecord {
  id               BigInt           @id @default(autoincrement())
  lotId            BigInt?          @map("lot_id")
  insurerName      String?          @map("insurer_name") @db.VarChar(191)
  policyNumber     String?          @map("policy_number") @db.VarChar(128)
  coverageType     String?          @map("coverage_type") @db.VarChar(128)
  coverageAmount   Decimal?         @map("coverage_amount") @db.Decimal(24, 2)
  currency         String?          @db.Char(3)
  validFrom        DateTime?        @map("valid_from") @db.Date
  validTo          DateTime?        @map("valid_to") @db.Date
  publicationState PublicationState @default(DRAFT) @map("publication_state")
  verificationStatus VerificationStatus @default(NOT_VERIFIED) @map("verification_status")
  notes            String?          @db.Text
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  lot Lot? @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([lotId])
  @@index([validTo])
  @@map("rc_insurance_records")
}

/// Valuation history, including revaluation and impairment. [M§9, MP10]
model Valuation {
  id                BigInt           @id @default(autoincrement())
  lotId             BigInt?          @map("lot_id")
  valuationDate     DateTime         @map("valuation_date") @db.Date
  /// valuation | revaluation | impairment
  valuationType     String           @default("valuation") @map("valuation_type") @db.VarChar(32)
  pricePerKg        Decimal?         @map("price_per_kg") @db.Decimal(24, 6)
  pricePerMetricTon Decimal?         @map("price_per_metric_ton") @db.Decimal(24, 6)
  totalAssessedValue Decimal?        @map("total_assessed_value") @db.Decimal(24, 2)
  currency          String           @default("USD") @db.Char(3)
  methodology       String?          @db.VarChar(255)
  pricingBenchmark  String?          @map("pricing_benchmark") @db.VarChar(255)
  valuerName        String?          @map("valuer_name") @db.VarChar(191)
  valuerIsIndependent Boolean        @default(false) @map("valuer_is_independent")
  documentId        BigInt?          @map("document_id")
  publicationState  PublicationState @default(DRAFT) @map("publication_state")
  /// Drives the stale-valuation alert. [MP11]
  validUntil        DateTime?        @map("valid_until") @db.Date
  notes             String?          @db.Text
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  lot Lot? @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([lotId, valuationDate])
  @@map("rc_valuations")
}

/// Material events and announcements affecting an asset. [M§9]
model MaterialEvent {
  id               BigInt           @id @default(autoincrement())
  lotId            BigInt?          @map("lot_id")
  unitId           BigInt?          @map("unit_id")
  eventType        String           @map("event_type") @db.VarChar(64)
  title            String           @db.VarChar(255)
  body             String?          @db.LongText
  occurredAt       DateTime         @map("occurred_at")
  publicationState PublicationState @default(DRAFT) @map("publication_state")
  createdById      BigInt?          @map("created_by_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  lot  Lot?  @relation(fields: [lotId], references: [id], onDelete: Restrict)
  unit Unit? @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([lotId, occurredAt])
  @@map("rc_material_events")
}

/// Digital Asset Passport — "a persistent digital identity for every asset
/// unit", with unique asset ID, specifications, certificates, provenance,
/// verification, custody, valuation, reserve and tokenization status,
/// blockchain references, history, QR access and downloadable evidence. [W§4 #14]
model Passport {
  id           BigInt @id @default(autoincrement())
  unitId       BigInt @unique @map("unit_id")
  /// Stable, public, non-guessable identifier used in the passport URL and QR.
  publicId     String @unique @map("public_id") @db.Char(26)
  /// Human-readable asset ID shown on the passport, e.g. RC-CU-03K07-0020.
  displayId    String @unique @map("display_id") @db.VarChar(64)

  publicationState PublicationState @default(DRAFT) @map("publication_state")
  /// Demonstration passports carry a permanent, visible ILLUSTRATIVE marker
  /// and are excluded from every reserve and program statistic. [W§8]
  isIllustrative   Boolean          @default(true) @map("is_illustrative")

  /// Integrity digest over the passport's approved evidence set, so a holder
  /// can confirm the record has not changed since it was shown to them.
  evidenceHash String? @map("evidence_hash") @db.Char(64)
  issuedAt     DateTime? @map("issued_at")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([publicationState])
  @@map("rc_passports")
}

// =============================================================================
// TOKEN PROGRAMS, RESERVES AND RECONCILIATION  [M§12, MP3, MP11, MP17]
// =============================================================================

/// An ERC-20 token series bound to an asset program. Name, symbol, decimals,
/// cap and allocations are configuration — never constants — and the contract
/// address stays null until a deployment is approved. [M§12]
model TokenProgram {
  id          BigInt @id @default(autoincrement())
  programId   BigInt? @map("program_id")
  key         String @unique @db.VarChar(64)
  tokenName   String? @map("token_name") @db.VarChar(128)
  tokenSymbol String? @map("token_symbol") @db.VarChar(32)
  decimals    Int     @default(18)
  /// Maximum supply, if a cap is approved. Null means not yet determined —
  /// we do not invent a supply figure.
  maxSupply   Decimal? @map("max_supply") @db.Decimal(38, 0)

  chainId         Int?    @map("chain_id")
  chainName       String? @map("chain_name") @db.VarChar(64)
  /// Null until the owner authorises deployment and the address is verified.
  contractAddress String? @map("contract_address") @db.Char(42)
  deploymentTxHash String? @map("deployment_tx_hash") @db.Char(66)
  deployedAt      DateTime? @map("deployed_at")
  isVerifiedOnExplorer Boolean @default(false) @map("is_verified_on_explorer")

  state            TokenFieldState  @default(PENDING)
  publicationState PublicationState @default(DRAFT) @map("publication_state")

  /// Reserve ratio policy, expressed as configuration. Null until approved.
  targetReserveRatio Decimal? @map("target_reserve_ratio") @db.Decimal(12, 6)

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  program      AssetProgram?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  allocations  TokenAllocation[]
  supplySnapshots SupplySnapshot[]
  reserveReports ReserveReport[]

  @@index([state])
  @@map("rc_token_programs")
}

/// Supply allocation buckets — treasury, participation, liquidity, reserve.
/// Percentages are rows, so an authorised administrator can change them.
model TokenAllocation {
  id             BigInt          @id @default(autoincrement())
  tokenProgramId BigInt          @map("token_program_id")
  key            String          @db.VarChar(64)
  label          String          @db.VarChar(128)
  percentage     Decimal?        @db.Decimal(9, 6)
  absoluteAmount Decimal?        @map("absolute_amount") @db.Decimal(38, 0)
  /// Vesting or lockup where approved. [MP3]
  vestingMonths  Int?            @map("vesting_months")
  cliffMonths    Int?            @map("cliff_months")
  walletAddress  String?         @map("wallet_address") @db.Char(42)
  state          TokenFieldState @default(PENDING)
  sortOrder      Int             @default(0) @map("sort_order")
  notes          String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  tokenProgram TokenProgram @relation(fields: [tokenProgramId], references: [id], onDelete: Cascade)

  @@unique([tokenProgramId, key])
  @@map("rc_token_allocations")
}

/// Raw on-chain events captured by the indexer. Idempotent by
/// (chainId, txHash, logIndex) so replays and reorg recovery cannot
/// double-count. [MP5 duplicate-event prevention, reorg handling]
model ChainEvent {
  id          BigInt   @id @default(autoincrement())
  chainId     Int      @map("chain_id")
  blockNumber BigInt   @map("block_number")
  blockHash   String   @map("block_hash") @db.Char(66)
  txHash      String   @map("tx_hash") @db.Char(66)
  logIndex    Int      @map("log_index")
  contractAddress String @map("contract_address") @db.Char(42)
  eventName   String   @map("event_name") @db.VarChar(128)
  argsJson    String   @map("args_json") @db.LongText
  occurredAt  DateTime @map("occurred_at")
  confirmations Int    @default(0)
  /// Set when a reorg removes the block that contained this log.
  isOrphaned  Boolean  @default(false) @map("is_orphaned")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([chainId, txHash, logIndex])
  @@index([contractAddress, eventName, blockNumber])
  @@index([isOrphaned, processedAt])
  @@map("rc_chain_events")
}

/// Point-in-time token supply, derived from chain state — never a
/// hand-editable balance. [MP5: "Financial or token balances must not be
/// maintained solely as manually editable database fields."]
model SupplySnapshot {
  id             BigInt   @id @default(autoincrement())
  tokenProgramId BigInt   @map("token_program_id")
  chainId        Int      @map("chain_id")
  blockNumber    BigInt   @map("block_number")
  totalSupply    Decimal  @map("total_supply") @db.Decimal(38, 0)
  circulatingSupply Decimal? @map("circulating_supply") @db.Decimal(38, 0)
  treasuryHeld   Decimal? @map("treasury_held") @db.Decimal(38, 0)
  lockedSupply   Decimal? @map("locked_supply") @db.Decimal(38, 0)
  burnedSupply   Decimal? @map("burned_supply") @db.Decimal(38, 0)
  redeemedSupply Decimal? @map("redeemed_supply") @db.Decimal(38, 0)
  capturedAt     DateTime @map("captured_at")
  createdAt      DateTime @default(now()) @map("created_at")

  tokenProgram TokenProgram @relation(fields: [tokenProgramId], references: [id], onDelete: Cascade)

  @@unique([tokenProgramId, chainId, blockNumber])
  @@index([capturedAt])
  @@map("rc_supply_snapshots")
}

/// A Proof-of-Reserves report. [MP11] Reserve coverage is calculated from
/// approved source data, never typed in.
model ReserveReport {
  id               BigInt           @id @default(autoincrement())
  tokenProgramId   BigInt?          @map("token_program_id")
  reportCode       String           @unique @map("report_code") @db.VarChar(64)
  periodStart      DateTime?        @map("period_start") @db.Date
  periodEnd        DateTime?        @map("period_end") @db.Date
  asOfDate         DateTime         @map("as_of_date") @db.Date

  eligibleReserveValue Decimal? @map("eligible_reserve_value") @db.Decimal(24, 2)
  tokenizedValue       Decimal? @map("tokenized_value") @db.Decimal(24, 2)
  /// Derived: eligibleReserveValue / tokenizedValue. Stored for history only.
  coverageRatio        Decimal? @map("coverage_ratio") @db.Decimal(12, 6)
  currency             String   @default("USD") @db.Char(3)
  valuationDate        DateTime? @map("valuation_date") @db.Date
  attestationDate      DateTime? @map("attestation_date") @db.Date

  /// An uploaded figure is never described as independently verified unless an
  /// approved attestation actually exists. [MP11]
  hasIndependentAttestation Boolean @default(false) @map("has_independent_attestation")
  attestationProvider String? @map("attestation_provider") @db.VarChar(191)
  documentId       BigInt?          @map("document_id")

  publicationState PublicationState @default(DRAFT) @map("publication_state")
  /// On-chain anchor of this report's content digest.
  contentHash      String?          @map("content_hash") @db.Char(64)
  anchorTxHash     String?          @map("anchor_tx_hash") @db.Char(66)

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tokenProgram TokenProgram? @relation(fields: [tokenProgramId], references: [id], onDelete: SetNull)
  lines        ReserveLine[]

  @@index([asOfDate])
  @@index([publicationState])
  @@map("rc_reserve_reports")
}

/// Reserve breakdown by program, lot and individual unit. [MP11]
model ReserveLine {
  id              BigInt        @id @default(autoincrement())
  reportId        BigInt        @map("report_id")
  programId       BigInt?       @map("program_id")
  lotId           BigInt?       @map("lot_id")
  unitId          BigInt?       @map("unit_id")
  quantity        Decimal?      @db.Decimal(24, 6)
  quantityUnit    String?       @map("quantity_unit") @db.VarChar(16)
  assessedValue   Decimal?      @map("assessed_value") @db.Decimal(24, 2)
  currency        String?       @db.Char(3)
  status          ReserveStatus @default(ELIGIBLE)
  exclusionReason String?       @map("exclusion_reason") @db.VarChar(255)

  report  ReserveReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  program AssetProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  lot     Lot?          @relation(fields: [lotId], references: [id], onDelete: SetNull)
  unit    Unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([lotId])
  @@map("rc_reserve_lines")
}

/// Reconciliation runs and the exceptions they raise. [MP11, MP17]
/// "The system must detect and report inconsistencies rather than silently
///  adjusting balances."
model ReconciliationRun {
  id          BigInt   @id @default(autoincrement())
  runType     String   @map("run_type") @db.VarChar(64)
  startedAt   DateTime @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  status      String   @default("running") @db.VarChar(32)
  checkedCount Int     @default(0) @map("checked_count")
  exceptionCount Int   @default(0) @map("exception_count")
  summaryJson String?  @map("summary_json") @db.LongText
  createdAt   DateTime @default(now()) @map("created_at")

  exceptions ReconciliationException[]

  @@index([runType, startedAt])
  @@map("rc_reconciliation_runs")
}

model ReconciliationException {
  id          BigInt    @id @default(autoincrement())
  runId       BigInt    @map("run_id")
  /// supply_mismatch | reserve_shortfall | stale_valuation | stale_attestation |
  /// missing_document | expiring_document | unverified_quantity |
  /// orphaned_token | custody_gap | ledger_drift
  code        String    @db.VarChar(64)
  severity    AuditSeverity @default(WARNING)
  entityType  String?   @map("entity_type") @db.VarChar(64)
  entityId    BigInt?   @map("entity_id")
  message     String    @db.Text
  detailJson  String?   @map("detail_json") @db.LongText
  status      String    @default("open") @db.VarChar(32)
  acknowledgedById BigInt? @map("acknowledged_by_id")
  acknowledgedAt   DateTime? @map("acknowledged_at")
  resolvedAt  DateTime? @map("resolved_at")
  resolutionNote String? @map("resolution_note") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  run ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([status, severity])
  @@index([entityType, entityId])
  @@map("rc_reconciliation_exceptions")
}

/// Double-entry style ledger for every balance-affecting action. [MP5, MP17]
/// Every entry carries a supporting reference, reason, timestamp, actor and
/// audit link — balances are derived from entries, never edited directly.
model LedgerEntry {
  id            BigInt   @id @default(autoincrement())
  ledgerKey     String   @map("ledger_key") @db.VarChar(64)
  entryType     String   @map("entry_type") @db.VarChar(64)
  direction     String   @db.VarChar(8)
  amount        Decimal  @db.Decimal(38, 18)
  currency      String   @db.VarChar(16)
  entityType    String?  @map("entity_type") @db.VarChar(64)
  entityId      BigInt?  @map("entity_id")
  counterparty  String?  @db.VarChar(191)
  txHash        String?  @map("tx_hash") @db.Char(66)
  walletAddress String?  @map("wallet_address") @db.Char(42)
  reference     String?  @db.VarChar(191)
  reason        String?  @db.Text
  occurredAt    DateTime @map("occurred_at")
  recordedById  BigInt?  @map("recorded_by_id")
  auditLogId    BigInt?  @map("audit_log_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([ledgerKey, occurredAt])
  @@index([entityType, entityId])
  @@map("rc_ledger_entries")
}

// =============================================================================
// PARTICIPATION: WAITLIST, ENQUIRIES, KYC, REDEMPTION  [M§15, MP6, MP8, MP12]
// =============================================================================

/// Project waitlist. Exactly the fields the client specifies. [M§15]
/// "No funds, payment details, wallet addresses or token reservations may be
///  accepted through the waitlist." — enforced by the absence of such columns
///  and by validation that rejects anything resembling them.
model WaitlistRegistration {
  id            BigInt @id @default(autoincrement())
  publicId      String @unique @map("public_id") @db.Char(26)
  firstName     String @map("first_name") @db.VarChar(128)
  lastName      String @map("last_name") @db.VarChar(128)
  email         String @db.VarChar(191)
  countryOfResidence String @map("country_of_residence") @db.Char(2)

  /// individual | institutional
  participantType String @map("participant_type") @db.VarChar(32)
  isIndustrialBuyer Boolean @default(false) @map("is_industrial_buyer")
  isAssetOwnerOriginator Boolean @default(false) @map("is_asset_owner_originator")
  organisationName String? @map("organisation_name") @db.VarChar(191)

  /// copper_powder | nickel_wire | both | future_programs
  materialInterest String @map("material_interest") @db.VarChar(32)
  /// A banded range, never a monetary commitment.
  interestRange    String? @map("interest_range") @db.VarChar(64)
  intendedParticipationType String? @map("intended_participation_type") @db.VarChar(64)

  /// Nationality and current location are supported technically but stay
  /// disabled until legally required. [M§15]
  nationality     String? @db.Char(2)
  currentLocation String? @map("current_location") @db.Char(2)

  /// Registration is only treated as confirmed after email verification. [M§15]
  emailVerifiedAt   DateTime? @map("email_verified_at")
  verificationTokenHash String? @unique @map("verification_token_hash") @db.Char(64)
  verificationSentAt DateTime? @map("verification_sent_at")
  verificationExpiresAt DateTime? @map("verification_expires_at")

  subscriptionStatus String @default("pending") @map("subscription_status") @db.VarChar(32)
  unsubscribedAt     DateTime? @map("unsubscribed_at")

  /// Registration source and campaign, for the required admin filters. [M§15]
  registrationSource String? @map("registration_source") @db.VarChar(128)
  campaignSource     String? @map("campaign_source") @db.VarChar(128)
  referrerUrl        String? @map("referrer_url") @db.VarChar(512)
  ipAddress          Bytes?  @map("ip_address") @db.VarBinary(16)
  userAgent          String? @map("user_agent") @db.VarChar(255)

  internalNotes String? @map("internal_notes") @db.Text
  assignedToId  BigInt? @map("assigned_to_id")

  /// Data-subject handling under approved retention procedures. [M§15]
  anonymisedAt DateTime? @map("anonymised_at")
  deletedAt    DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  consents Consent[]

  @@unique([email, deletedAt])
  @@index([countryOfResidence])
  @@index([participantType])
  @@index([materialInterest])
  @@index([subscriptionStatus])
  @@map("rc_waitlist_registrations")
}

/// Consent records: what was agreed, to which version, when and from where.
/// [M§15, MP6 terms/privacy/risk acceptance with version, timestamp, IP]
model Consent {
  id            BigInt   @id @default(autoincrement())
  waitlistId    BigInt?  @map("waitlist_id")
  userId        BigInt?  @map("user_id")
  /// updates | privacy | risk | terms | no_offer_acknowledgement
  consentType   String   @map("consent_type") @db.VarChar(64)
  granted       Boolean  @default(true)
  documentKey   String?  @map("document_key") @db.VarChar(64)
  documentVersion Int?   @map("document_version")
  textSnapshot  String?  @map("text_snapshot") @db.Text
  ipAddress     Bytes?   @map("ip_address") @db.VarBinary(16)
  userAgent     String?  @map("user_agent") @db.VarChar(255)
  grantedAt     DateTime @default(now()) @map("granted_at")
  withdrawnAt   DateTime? @map("withdrawn_at")

  waitlist WaitlistRegistration? @relation(fields: [waitlistId], references: [id], onDelete: Cascade)

  @@index([waitlistId])
  @@index([consentType])
  @@map("rc_consents")
}

/// Contact and enterprise enquiries, routed by subject. [W§4 #6]
model Enquiry {
  id           BigInt   @id @default(autoincrement())
  publicId     String   @unique @map("public_id") @db.Char(26)
  /// general | asset_owner | industrial_buyer | institution | enterprise |
  /// licensing | media | compliance | support | early_participation
  category     String   @db.VarChar(64)
  firstName    String?  @map("first_name") @db.VarChar(128)
  lastName     String?  @map("last_name") @db.VarChar(128)
  email        String   @db.VarChar(191)
  organisation String?  @db.VarChar(191)
  countryCode  String?  @map("country_code") @db.Char(2)
  subject      String?  @db.VarChar(255)
  message      String   @db.Text
  status       String   @default("new") @db.VarChar(32)
  assignedToId BigInt?  @map("assigned_to_id")
  internalNotes String? @map("internal_notes") @db.Text
  ipAddress    Bytes?   @map("ip_address") @db.VarBinary(16)
  userAgent    String?  @map("user_agent") @db.VarChar(255)
  respondedAt  DateTime? @map("responded_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([category, status])
  @@index([email])
  @@map("rc_enquiries")
}

/// A participant account profile. Wallet, purchase, Proof-of-Reserves and
/// redemption functions remain inactive until authorised. [MP8]
model Participant {
  id                 BigInt    @id @default(autoincrement())
  userId             BigInt    @unique @map("user_id")
  publicId           String    @unique @map("public_id") @db.Char(26)
  participantType    String    @default("individual") @map("participant_type") @db.VarChar(32)
  organisationName   String?   @map("organisation_name") @db.VarChar(191)
  countryOfResidence String?   @map("country_of_residence") @db.Char(2)
  nationality        String?   @db.Char(2)
  /// Eligibility is a decision, not an assumption: nothing is eligible until
  /// a compliance decision is recorded. [MP6]
  eligibilityStatus  String    @default("not_assessed") @map("eligibility_status") @db.VarChar(32)
  eligibilityDecidedAt DateTime? @map("eligibility_decided_at")
  eligibilityDecidedById BigInt? @map("eligibility_decided_by_id")
  riskRating         String?   @map("risk_rating") @db.VarChar(32)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycCases KycCase[]
  wallets  ParticipantWallet[]
  redemptionRequests RedemptionRequest[]

  @@index([eligibilityStatus])
  @@map("rc_participants")
}

/// KYC / KYB case with full decision audit. Provider is pluggable — the client
/// selects it, we integrate it. [MP6]
model KycCase {
  id              BigInt    @id @default(autoincrement())
  participantId   BigInt    @map("participant_id")
  caseType        String    @default("kyc") @map("case_type") @db.VarChar(16)
  provider        String?   @db.VarChar(64)
  providerCaseId  String?   @map("provider_case_id") @db.VarChar(191)
  status          String    @default("not_started") @db.VarChar(32)
  /// Screening outcomes are recorded separately so a decision can be explained.
  identityVerified   Boolean @default(false) @map("identity_verified")
  livenessVerified   Boolean @default(false) @map("liveness_verified")
  sanctionsHit       Boolean @default(false) @map("sanctions_hit")
  pepHit             Boolean @default(false) @map("pep_hit")
  adverseMediaHit    Boolean @default(false) @map("adverse_media_hit")
  sourceOfFundsDeclared Boolean @default(false) @map("source_of_funds_declared")
  sourceOfWealthRequired Boolean @default(false) @map("source_of_wealth_required")
  enhancedDueDiligence Boolean @default(false) @map("enhanced_due_diligence")
  beneficialOwnersCollected Boolean @default(false) @map("beneficial_owners_collected")
  decision        String?   @db.VarChar(32)
  decisionReason  String?   @map("decision_reason") @db.Text
  decidedById     BigInt?   @map("decided_by_id")
  decidedAt       DateTime? @map("decided_at")
  nextReviewDue   DateTime? @map("next_review_due") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([nextReviewDue])
  @@map("rc_kyc_cases")
}

/// Wallet addresses proven by signature. Inactive in pre-launch. [MP7, MP12]
model ParticipantWallet {
  id             BigInt    @id @default(autoincrement())
  participantId  BigInt    @map("participant_id")
  chainId        Int       @map("chain_id")
  address        String    @db.Char(42)
  /// Ownership is proven by a signed challenge, never by assertion.
  proofSignature String?   @map("proof_signature") @db.VarChar(255)
  proofMessage   String?   @map("proof_message") @db.VarChar(512)
  verifiedAt     DateTime? @map("verified_at")
  screeningStatus String   @default("not_screened") @map("screening_status") @db.VarChar(32)
  screenedAt     DateTime? @map("screened_at")
  isPrimary      Boolean   @default(false) @map("is_primary")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([chainId, address, participantId])
  @@index([address])
  @@map("rc_participant_wallets")
}

/// Physical redemption request. Built complete, kept inactive until
/// authorised. [MP12] Legal redemption rights, minimum amounts, delivery
/// conditions, fees, taxes and custody rules are all configuration.
model RedemptionRequest {
  id             BigInt           @id @default(autoincrement())
  publicId       String           @unique @map("public_id") @db.Char(26)
  participantId  BigInt           @map("participant_id")
  tokenProgramId BigInt?          @map("token_program_id")

  requestedQuantity Decimal? @map("requested_quantity") @db.Decimal(24, 6)
  quantityUnit      String?  @map("quantity_unit") @db.VarChar(16)
  tokenAmount       Decimal? @map("token_amount") @db.Decimal(38, 0)

  status         RedemptionStatus @default(REQUESTED)
  /// Compliance is re-checked at redemption time, not assumed from onboarding.
  complianceRecheckedAt DateTime? @map("compliance_rechecked_at")
  jurisdictionCheckPassed Boolean? @map("jurisdiction_check_passed")

  /// Cost breakdown — every component configurable, none hard-coded.
  redemptionFee   Decimal? @map("redemption_fee") @db.Decimal(24, 2)
  custodyCharge   Decimal? @map("custody_charge") @db.Decimal(24, 2)
  packagingCharge Decimal? @map("packaging_charge") @db.Decimal(24, 2)
  shippingCharge  Decimal? @map("shipping_charge") @db.Decimal(24, 2)
  insuranceCharge Decimal? @map("insurance_charge") @db.Decimal(24, 2)
  taxAmount       Decimal? @map("tax_amount") @db.Decimal(24, 2)
  totalCost       Decimal? @map("total_cost") @db.Decimal(24, 2)
  currency        String   @default("USD") @db.Char(3)

  deliveryMethod  String? @map("delivery_method") @db.VarChar(64)
  deliveryAddress String? @map("delivery_address") @db.Text
  customsReference String? @map("customs_reference") @db.VarChar(191)

  termsAcceptedAt DateTime? @map("terms_accepted_at")
  signatureReference String? @map("signature_reference") @db.VarChar(191)

  /// Maker-checker: approval requires a different administrator. [MP12]
  reviewedById  BigInt?   @map("reviewed_by_id")
  reviewedAt    DateTime? @map("reviewed_at")
  approvedById  BigInt?   @map("approved_by_id")
  approvedAt    DateTime? @map("approved_at")
  rejectionReason String? @map("rejection_reason") @db.Text

  tokenLockedAt DateTime? @map("token_locked_at")
  burnTxHash    String?   @map("burn_tx_hash") @db.Char(66)
  burnedAt      DateTime? @map("burned_at")
  custodyReleaseRef String? @map("custody_release_ref") @db.VarChar(191)
  shippedAt     DateTime? @map("shipped_at")
  deliveredAt   DateTime? @map("delivered_at")
  cancelledAt   DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  participant Participant      @relation(fields: [participantId], references: [id], onDelete: Restrict)
  units       RedemptionUnit[]

  @@index([status])
  @@index([participantId])
  @@map("rc_redemption_requests")
}

/// The specific containers or coils allocated to a redemption. [MP12]
model RedemptionUnit {
  id                  BigInt   @id @default(autoincrement())
  redemptionRequestId BigInt   @map("redemption_request_id")
  unitId              BigInt   @map("unit_id")
  allocatedAt         DateTime @default(now()) @map("allocated_at")
  releasedAt          DateTime? @map("released_at")
  substitutedForUnitId BigInt? @map("substituted_for_unit_id")
  substitutionReason  String?  @map("substitution_reason") @db.Text

  request RedemptionRequest @relation(fields: [redemptionRequestId], references: [id], onDelete: Cascade)
  unit    Unit              @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([redemptionRequestId, unitId])
  @@map("rc_redemption_units")
}

/// Outbound notifications and their delivery state. [MP5 notification service,
/// M§19 monitoring of email delivery]
model Notification {
  id          BigInt    @id @default(autoincrement())
  channel     String    @default("email") @db.VarChar(32)
  templateKey String    @map("template_key") @db.VarChar(64)
  recipient   String    @db.VarChar(191)
  userId      BigInt?   @map("user_id")
  subject     String?   @db.VarChar(255)
  payloadJson String?   @map("payload_json") @db.LongText
  status      String    @default("queued") @db.VarChar(32)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.Text
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([recipient])
  @@map("rc_notifications")
}

/// Support tickets raised from the portal or the apps. [MP8, W§4 #50]
model SupportTicket {
  id           BigInt   @id @default(autoincrement())
  publicId     String   @unique @map("public_id") @db.Char(26)
  userId       BigInt?  @map("user_id")
  email        String?  @db.VarChar(191)
  category     String   @db.VarChar(64)
  subject      String   @db.VarChar(255)
  body         String   @db.Text
  status       String   @default("open") @db.VarChar(32)
  priority     String   @default("normal") @db.VarChar(16)
  assignedToId BigInt?  @map("assigned_to_id")
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([status, priority])
  @@map("rc_support_tickets")
}

// =============================================================================
// CONTENT  [M§16 CMS scope, W§4 51-page sitemap]
// =============================================================================

/// Editorial pages and their per-locale content. The 51 required pages are
/// rows here, so the client's team can edit every one of them without a
/// deployment.
model Page {
  id               BigInt           @id @default(autoincrement())
  slug             String           @unique @db.VarChar(191)
  /// Matches the client's own numbering in the Website Development brief.
  briefPageNumber  Int?             @map("brief_page_number")
  navGroup         String?          @map("nav_group") @db.VarChar(64)
  template         String           @default("standard") @db.VarChar(64)
  publicationState PublicationState @default(DRAFT) @map("publication_state")
  /// Draft and under-review pages are excluded from sitemap, feeds and APIs,
  /// and served with noindex. [M§16, M§19]
  isIndexable      Boolean          @default(false) @map("is_indexable")
  requiredMode     String?          @map("required_mode") @db.VarChar(64)
  requiredModule   String?          @map("required_module") @db.VarChar(64)
  sortOrder        Int              @default(0) @map("sort_order")
  version          Int              @default(1)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  approvedById     BigInt?          @map("approved_by_id")
  approvedAt       DateTime?        @map("approved_at")
  publishedAt      DateTime?        @map("published_at")
  archivedAt       DateTime?        @map("archived_at")

  translations PageTranslation[]
  blocks       ContentBlock[]

  @@index([publicationState, isIndexable])
  @@index([navGroup, sortOrder])
  @@map("rc_pages")
}

model PageTranslation {
  id             BigInt           @id @default(autoincrement())
  pageId         BigInt           @map("page_id")
  locale         String           @db.VarChar(10)
  title          String           @db.VarChar(255)
  subtitle       String?          @db.VarChar(512)
  excerpt        String?          @db.Text
  seoTitle       String?          @map("seo_title") @db.VarChar(255)
  seoDescription String?          @map("seo_description") @db.VarChar(512)
  ogImageKey     String?          @map("og_image_key") @db.VarChar(512)
  canonicalUrl   String?          @map("canonical_url") @db.VarChar(512)
  publicationState PublicationState @default(DRAFT) @map("publication_state")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@map("rc_page_translations")
}

/// Reusable content blocks — the component library the client asks for:
/// program cards, asset records, passports, reserve metrics, document cards,
/// status badges, timelines, FAQ and CTA blocks. [W§9]
model ContentBlock {
  id         BigInt   @id @default(autoincrement())
  pageId     BigInt?  @map("page_id")
  blockKey   String   @map("block_key") @db.VarChar(64)
  blockType  String   @map("block_type") @db.VarChar(64)
  sortOrder  Int      @default(0) @map("sort_order")
  /// Per-locale payload keyed by locale code.
  dataJson   String   @map("data_json") @db.LongText
  publicationState PublicationState @default(DRAFT) @map("publication_state")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  page Page? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sortOrder])
  @@map("rc_content_blocks")
}

/// FAQ entries, organised by the client's required categories. [W§4 #44]
model FaqEntry {
  id               BigInt           @id @default(autoincrement())
  category         String           @db.VarChar(64)
  locale           String           @default("en") @db.VarChar(10)
  question         String           @db.VarChar(512)
  answer           String           @db.LongText
  sortOrder        Int              @default(0) @map("sort_order")
  publicationState PublicationState @default(DRAFT) @map("publication_state")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([category, locale, sortOrder])
  @@map("rc_faq_entries")
}

/// News, announcements and project milestones. [W§4 #5]
model Announcement {
  id               BigInt           @id @default(autoincrement())
  slug             String           @unique @db.VarChar(191)
  locale           String           @default("en") @db.VarChar(10)
  category         String           @db.VarChar(64)
  title            String           @db.VarChar(255)
  excerpt          String?          @db.Text
  body             String           @db.LongText
  publishedOn      DateTime?        @map("published_on") @db.Date
  publicationState PublicationState @default(DRAFT) @map("publication_state")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([category, publishedOn])
  @@map("rc_announcements")
}

/// Corporate development status entries — the visible project-status board
/// the client wants instead of unverifiable progress claims. [W§4 #3]
model DevelopmentStatusItem {
  id               BigInt           @id @default(autoincrement())
  workstream       String           @db.VarChar(128)
  phaseNumber      Int?             @map("phase_number")
  label            String           @db.VarChar(255)
  /// planned | in_progress | completed | blocked | awaiting_owner_input
  status           String           @db.VarChar(32)
  detail           String?          @db.Text
  targetDate       DateTime?        @map("target_date") @db.Date
  completedDate    DateTime?        @map("completed_date") @db.Date
  sortOrder        Int              @default(0) @map("sort_order")
  publicationState PublicationState @default(DRAFT) @map("publication_state")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([workstream, sortOrder])
  @@map("rc_development_status_items")
}
