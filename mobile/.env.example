# Base URL of the ReserveChain REST API (WordPress plugin namespace rc/v1)
EXPO_PUBLIC_API_URL=http://localhost:8088/wp-json/rc/v1
# 1 = use built-in placeholder data (no backend needed). 0 = call the API.
EXPO_PUBLIC_API_MOCK=1
# Auto-logout after N minutes without interaction (default 5)
EXPO_PUBLIC_INACTIVITY_MINUTES=5
