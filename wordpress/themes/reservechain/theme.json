{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,

    "layout": {
      "contentSize": "820px",
      "wideSize": "1340px"
    },

    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": false,
      "customGradient": false,
      "palette": [
        {
          "slug": "base",
          "color": "#070A12",
          "name": "Base — deep navy black"
        },
        {
          "slug": "surface",
          "color": "#0C111C",
          "name": "Surface"
        },
        {
          "slug": "surface-raised",
          "color": "#131A28",
          "name": "Surface raised"
        },
        {
          "slug": "graphite",
          "color": "#1C2433",
          "name": "Graphite"
        },
        {
          "slug": "hairline",
          "color": "#27303F",
          "name": "Hairline"
        },
        {
          "slug": "contrast",
          "color": "#EEF1F6",
          "name": "Contrast — primary text"
        },
        {
          "slug": "contrast-muted",
          "color": "#9BA6B7",
          "name": "Contrast muted — secondary text"
        },
        {
          "slug": "contrast-subtle",
          "color": "#6B7689",
          "name": "Contrast subtle — metadata"
        },
        {
          "slug": "gold",
          "color": "#C9A227",
          "name": "Gold — primary accent"
        },
        {
          "slug": "gold-bright",
          "color": "#E6C458",
          "name": "Gold bright"
        },
        {
          "slug": "gold-deep",
          "color": "#8C6F14",
          "name": "Gold deep"
        },
        {
          "slug": "copper",
          "color": "#B4663A",
          "name": "Copper — Copper Powder programme"
        },
        {
          "slug": "copper-bright",
          "color": "#D98E5A",
          "name": "Copper bright"
        },
        {
          "slug": "nickel",
          "color": "#9BA4AE",
          "name": "Nickel — Nickel Wire programme"
        },
        {
          "slug": "nickel-bright",
          "color": "#C5CCD4",
          "name": "Nickel bright"
        },
        {
          "slug": "status-pending",
          "color": "#8A94A6",
          "name": "Status — pending"
        },
        {
          "slug": "status-review",
          "color": "#C9A227",
          "name": "Status — under review"
        },
        {
          "slug": "status-verified",
          "color": "#4E9E7E",
          "name": "Status — verified"
        },
        {
          "slug": "status-attention",
          "color": "#C2703E",
          "name": "Status — attention"
        },
        {
          "slug": "status-critical",
          "color": "#B04A45",
          "name": "Status — critical"
        }
      ]
    },

    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "dropCap": false,
      "writingMode": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display — institutional serif",
          "fontFamily": "\"RC Display\", \"Iowan Old Style\", \"Palatino Linotype\", Palatino, \"Source Serif 4\", Georgia, \"Times New Roman\", serif"
        },
        {
          "slug": "body",
          "name": "Body — readable sans",
          "fontFamily": "\"RC Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Roboto, \"Helvetica Neue\", Arial, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Data — tabular mono",
          "fontFamily": "\"RC Mono\", ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace"
        }
      ],
      "fontSizes": [
        { "slug": "xs",   "name": "Extra small", "size": "0.75rem",  "fluid": false },
        { "slug": "sm",   "name": "Small",       "size": "0.875rem", "fluid": false },
        { "slug": "base", "name": "Base",        "size": "1rem",     "fluid": false },
        { "slug": "md",   "name": "Medium",      "size": "1.125rem", "fluid": { "min": "1.0625rem", "max": "1.1875rem" } },
        { "slug": "lg",   "name": "Large",       "size": "1.375rem", "fluid": { "min": "1.25rem",   "max": "1.5rem" } },
        { "slug": "xl",   "name": "Extra large", "size": "1.875rem", "fluid": { "min": "1.5rem",    "max": "2rem" } },
        { "slug": "2xl",  "name": "2X large",    "size": "2.5rem",   "fluid": { "min": "1.875rem",  "max": "2.75rem" } },
        { "slug": "3xl",  "name": "3X large",    "size": "3.25rem",  "fluid": { "min": "2.25rem",   "max": "3.5rem" } },
        { "slug": "4xl",  "name": "Hero",        "size": "4rem",     "fluid": { "min": "2.5rem",    "max": "4.25rem" } }
      ]
    },

    "spacing": {
      "defaultSpacingSizes": false,
      "units": ["px", "em", "rem", "vh", "vw", "%"],
      "spacingSizes": [
        { "slug": "10", "name": "1 — hairline", "size": "0.25rem" },
        { "slug": "20", "name": "2 — tight",    "size": "0.5rem" },
        { "slug": "30", "name": "3 — snug",     "size": "0.75rem" },
        { "slug": "40", "name": "4 — base",     "size": "1rem" },
        { "slug": "50", "name": "5 — comfy",    "size": "1.5rem" },
        { "slug": "60", "name": "6 — loose",    "size": "2rem" },
        { "slug": "70", "name": "7 — section",  "size": "3rem" },
        { "slug": "80", "name": "8 — major",    "size": "4.5rem" },
        { "slug": "90", "name": "9 — hero",     "size": "6.5rem" }
      ]
    },

    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },

    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "slug": "raised", "name": "Raised", "shadow": "0 1px 2px rgba(0,0,0,.45), 0 8px 24px rgba(0,0,0,.28)" },
        { "slug": "panel",  "name": "Panel",  "shadow": "0 1px 0 rgba(255,255,255,.04) inset, 0 12px 40px rgba(0,0,0,.35)" }
      ]
    },

    "custom": {
      "hairline": "1px solid var(--wp--preset--color--hairline)",
      "radius": {
        "sm": "3px",
        "md": "6px",
        "lg": "10px"
      },
      "transition": {
        "fast": "120ms cubic-bezier(.2,0,.2,1)",
        "base": "220ms cubic-bezier(.2,0,.2,1)"
      },
      "measure": "68ch"
    }
  },

  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.65"
    },
    "spacing": {
      "padding": {
        "left": "var(--wp--preset--spacing--50)",
        "right": "var(--wp--preset--spacing--50)"
      },
      "blockGap": "var(--wp--preset--spacing--50)"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "600",
          "lineHeight": "1.15",
          "letterSpacing": "-0.011em"
        },
        "color": { "text": "var(--wp--preset--color--contrast)" }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--3xl)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--2xl)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--xl)" } },
      "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--lg)" } },
      "h5": { "typography": { "fontSize": "var(--wp--preset--font-size--md)" } },
      "h6": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "var(--wp--preset--font-size--sm)",
          "textTransform": "uppercase",
          "letterSpacing": "0.08em",
          "fontWeight": "600"
        },
        "color": { "text": "var(--wp--preset--color--contrast-muted)" }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--gold-bright)" },
        "typography": { "textDecoration": "none" },
        ":hover": { "typography": { "textDecoration": "underline" } },
        ":focus": { "typography": { "textDecoration": "underline" } }
      },
      "caption": {
        "color": { "text": "var(--wp--preset--color--contrast-subtle)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--sm)" }
      }
    },
    "blocks": {
      "core/table": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "var(--wp--preset--font-size--sm)"
        }
      },
      "core/code": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--mono)" },
        "color": { "background": "var(--wp--preset--color--graphite)" }
      },
      "core/separator": {
        "color": { "text": "var(--wp--preset--color--hairline)" }
      }
    }
  },

  "templateParts": [
    { "name": "header",            "title": "Header",            "area": "header" },
    { "name": "footer",            "title": "Footer",            "area": "footer" },
    { "name": "prelaunch-notice",  "title": "Pre-launch notice", "area": "uncategorized" }
  ],

  "customTemplates": [
    { "name": "page-asset-program", "title": "Asset programme", "postTypes": ["page"] },
    { "name": "page-wide",          "title": "Full width",      "postTypes": ["page"] }
  ]
}
