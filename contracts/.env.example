# ReserveChain.io contracts — environment template. TESTNET ONLY.
# Copy to .env and fill locally. NEVER commit .env. Use a dedicated, low-value testnet deployer key.

# RPC endpoint for Ethereum Sepolia (e.g. from your own node or an RPC provider)
SEPOLIA_RPC_URL=
# Optional: Polygon Amoy RPC endpoint
AMOY_RPC_URL=
# 0x-prefixed 32-byte hex private key of the TESTNET deployer account
DEPLOYER_PRIVATE_KEY=
# Etherscan API v2 key (used for source verification on Sepolia / Amoy)
ETHERSCAN_API_KEY=

# --- Audit anchoring (scripts/anchor-audit.ts) ---
# Base URL of the WordPress site exposing /wp-json/rc/v1/audit/head
WP_URL=http://localhost:8088
# Optional: WordPress user + Application Password with capability rc_anchor_audit (to report the anchor tx back)
WP_USER=
WP_APP_PASSWORD=

# --- Safety ---
# Mainnet deployment is NOT authorised. Leave unset.
# ALLOW_MAINNET=
# Set to "true" to print a gas report during tests
REPORT_GAS=
