{
  "name": "@reservechain/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "ReserveChain.io smart contracts (testnet only). Industrial-metals RWA ERC-20 platform — in development.",
  "license": "UNLICENSED",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "gas": "cross-env REPORT_GAS=true hardhat test",
    "typecheck": "tsc --noEmit -p .",
    "node": "hardhat node",
    "deploy:hardhat": "hardhat run scripts/deploy.ts --network hardhat",
    "deploy:localhost": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network amoy",
    "verify:sepolia": "hardhat run scripts/verify.ts --network sepolia",
    "verify:amoy": "hardhat run scripts/verify.ts --network amoy",
    "admin-status:sepolia": "hardhat run scripts/admin-status.ts --network sepolia",
    "anchor:localhost": "hardhat run scripts/anchor-audit.ts --network localhost",
    "anchor:sepolia": "hardhat run scripts/anchor-audit.ts --network sepolia",
    "slither": "slither . --config-file slither.config.json",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "~5.4.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^4.5.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.5",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9"
  },
  "engines": {
    "node": ">=20"
  }
}
