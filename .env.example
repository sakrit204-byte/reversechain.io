# ReserveChain.io — environment template
#
# Copy to .env and fill in. NEVER commit .env or any real credential.
# Per the client's handover requirements, the delivered repository contains
# environment TEMPLATES only; live credentials are transferred separately
# through the credentials handover register.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development                      # development | staging | production
APP_NAME=ReserveChain.io

# ── Database (docker compose) ─────────────────────────────────────────────────
DB_NAME=reservechain
DB_USER=reservechain
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root
DB_PORT=3307

# ── WordPress (CMS / API) ─────────────────────────────────────────────────────
WP_PORT=8080
WP_URL=http://localhost:8080
WP_DEBUG=1
WP_DISALLOW_FILE_MODS=false
WP_FORCE_SSL_ADMIN=false

# ── Mail (waitlist double opt-in, enquiries, alerts) ──────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM_ADDRESS=no-reply@reservechain.io
MAIL_FROM_NAME=ReserveChain.io
# Staging/production only — provider chosen with the project owner:
# MAIL_TRANSPORT=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# ── Tooling ───────────────────────────────────────────────────────────────────
ADMINER_PORT=8081

# ── Public site (apps/web) ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
RC_API_BASE_URL=http://localhost:8080/wp-json/rc/v1
RC_API_APP_USER=                         # WordPress application-password user
RC_API_APP_PASSWORD=                     # WordPress application password
REVALIDATE_SECRET=change_me

# ── Blockchain ────────────────────────────────────────────────────────────────
# No Ethereum Mainnet deployment may occur without the project owner's written
# authorization (Master Developer Instructions, Phase 3 & Phase 20).
CHAIN_ENV=sepolia                        # anvil | sepolia | mainnet(authorized)
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=
ETHERSCAN_API_KEY=
# Deployer key is used for TESTNET ONLY and is rotated before handover.
# Never store a production seed phrase or private key in this file.
DEPLOYER_PRIVATE_KEY=
# Safe multisig that receives every privileged role after deployment:
ADMIN_SAFE_ADDRESS=
TIMELOCK_MIN_DELAY_SECONDS=172800

# ── chain-sync service ────────────────────────────────────────────────────────
CHAIN_SYNC_START_BLOCK=
CHAIN_SYNC_CONFIRMATIONS=12
CHAIN_SYNC_POLL_MS=12000
